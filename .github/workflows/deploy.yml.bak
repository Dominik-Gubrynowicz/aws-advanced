name: Deploy Infrastructure

on:
  push:
    branches:
      - main
    paths:
      - 'terraform/**'
      - '.github/workflows/**'

# To use this workflow, set the AWS_ROLE_ARN in GitHub Secrets and Variables.
# E.g., AWS_ROLE_ARN = arn:aws:iam::123456789012:role/aws-advanced-github-actions-role
env:
  AWS_REGION: "eu-west-1"
  AWS_ROLE_ARN: ${{ secrets.AWS_ROLE_ARN }}

jobs:
  # ----------------------------------------------------------------------------
  # Phase 0: Account Baseline
  # ----------------------------------------------------------------------------
  deploy-account-baseline:
    name: Deploy Account Baseline
    uses: ./.github/workflows/terraform-apply.yml
    with:
      working-directory: terraform/account
      aws-region: eu-west-1
      role-to-assume: $AWS_ROLE_ARN

  # ----------------------------------------------------------------------------
  # Phase 1: Storage
  # ----------------------------------------------------------------------------
  deploy-storage:
    name: Deploy 01-storage
    uses: ./.github/workflows/terraform-apply.yml
    with:
      working-directory: terraform/01-storage
      aws-region: eu-west-1
      role-to-assume: $AWS_ROLE_ARN
  # # ----------------------------------------------------------------------------
  # # Phase 2: Pipeline
  # # ----------------------------------------------------------------------------
  # deploy-pipeline:
  #   name: Deploy 02-pipeline
  #   needs: deploy-storage
  #   uses: ./.github/workflows/terraform-apply.yml
  #   with:
  #     working-directory: terraform/02-pipeline
  #     aws-region: eu-west-1
  #     role-to-assume: $AWS_ROLE_ARN

  # # ----------------------------------------------------------------------------
  # # Phase 3: API
  # # ----------------------------------------------------------------------------
  # deploy-api:
  #   name: Deploy 03-api
  #   needs: deploy-pipeline
  #   uses: ./.github/workflows/terraform-apply.yml
  #   with:
  #     working-directory: terraform/03-api
  #     aws-region: eu-west-1
  #     role-to-assume: $AWS_ROLE_ARN

  # # ----------------------------------------------------------------------------
  # # Phase 4: CDN
  # # ----------------------------------------------------------------------------
  # deploy-cdn:
  #   name: Deploy 04-cdn
  #   needs: deploy-api
  #   uses: ./.github/workflows/terraform-apply.yml
  #   with:
  #     working-directory: terraform/04-cdn
  #     aws-region: eu-west-1
  #     role-to-assume: $AWS_ROLE_ARN